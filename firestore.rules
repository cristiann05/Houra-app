rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);

      match /entries/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidEntry(request.resource.data);
        allow update: if isOwner(userId) && isValidEntry(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    // Cualquier ruta no contemplada arriba queda denegada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'hourlyRate']) &&
             data.name is string && data.name.size() > 0 &&
             data.email is string &&
             data.hourlyRate is number && data.hourlyRate > 0;
    }

    function isValidEntry(data) {
      return data.keys().hasAll(['concept', 'hours', 'rate', 'tag', 'date']) &&
             data.concept is string && data.concept.size() > 0 &&
             data.hours is number && data.hours > 0 &&
             data.rate is number && data.rate > 0 &&
             data.tag is string &&
             data.date is timestamp;
    }
  }
}
