<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema aplicado a la ventana de Android mientras arranca el proceso.
         Muestra el splash nativo de Houra. Se retira automáticamente en cuanto
         Flutter pinta su primer frame (nuestra SplashScreen animada). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema aplicado en cuanto el proceso arranca (antes/durante Flutter). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
